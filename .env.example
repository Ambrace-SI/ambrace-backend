DYNAMODB_TABLE_NAME=ambrace-local-sessions
AWS_REGION=ap-south-1
# 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and every
# database call then waits about 2 seconds before falling back.
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8000
GOOGLE_API_KEY=replace-me
GEMINI_LIVE_MODEL=gemini-3.8-live
VIVA_SESSION_DURATION_MINUTES=5
# Leave both empty to run locally with every protected route returning 401.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
